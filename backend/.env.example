# Local development database (Docker container: movielanche-pg).
# NEVER commit real credentials -- the hosted values live in the team's
# shared secret store, not in git.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=movielanche
DB_USER=movielanche
DB_PASSWORD=movielanche_local_dev

# Server
PORT=5000

# Auth
# MUST be >= 32 characters or the server refuses to boot. Generate with:
#   openssl rand -hex 32
JWT_SECRET=dev-only-change-me-change-this-to-32-plus-chars

# The cinema's timezone. Show times are local wall-clock, so "has this show
# started?" must be judged here, not on the database server (hosted Postgres is
# usually UTC, which made the cutoff 5h30m too lenient).
CINEMA_TZ=Asia/Kolkata

# Rate limiting. RATE_LIMIT_MAX is a MULTIPLIER on the built-in ceilings
# (auth 40 / 15min, bookings 60 / min, api 300 / min). Set 0 to disable.
# RATE_LIMIT_MAX=1

# Number of proxy hops to trust for req.ip. The default is 1; behind more hops,
# raise it or every caller shares one bucket.
# TRUST_PROXY=1

# Lock the CORS origin down before deploying.
# CORS_ORIGIN=https://your-frontend

# Only if your provider uses a self-signed certificate. Never commit real values.
# DB_SSL_REJECT_UNAUTHORIZED=false